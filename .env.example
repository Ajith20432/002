# ZORA — safe defaults. Copy to .env. Paper trading unless ALL live conditions below are met.
EXCHANGE_ID=htx                  # binance | bybit | okx | htx
SYMBOL=ETH/USDT
SYMBOLS=ETH/USDT
TIMEFRAMES=15m,1h,4h
BTC_CONTEXT_SYMBOL=BTC/USDT

# ---- Live trading: stays locked unless LIVE_TRADING, I_UNDERSTAND_THE_RISK AND the keys are all set ----
LIVE_TRADING=false
I_UNDERSTAND_THE_RISK=false
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSWORD=           # OKX (and a few others) only
# Optional per-exchange credentials (used instead of the EXCHANGE_* ones for that exchange)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSWORD=
HTX_API_KEY=
HTX_API_SECRET=
HTX_API_PASSWORD=
NATIVE_PROTECTION_REQUIRED=true  # refuse live entries that cannot get exchange-side stop/take-profit
RECONCILE_ON_START=true

# ---- Capital and risk (hard limits; no signal, AI or learned weight can override them) ----
STARTING_CAPITAL=1000
RISK_PER_TRADE_PCT=1.0
MAX_EXPOSURE_PCT=30
MAX_DAILY_LOSS_PCT=6              # hard kill switch; sits ABOVE the 4% circuit breaker
MAX_DRAWDOWN_PCT=15
ALLOW_SHORTS=false

# ---- Costs used by paper mode and backtests ----
FEE_RATE=0.001
SLIPPAGE_BPS=5
EXECUTION_LATENCY_MS=250

POLL_SECONDS=60
DB_PATH=zora.db
LOG_LEVEL=INFO

# ---- Dashboard (0 = off). Keep it on 127.0.0.1: it has no login. ----
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000

# ---- 5-AI council (advisory; risk.py always has the final veto) ----
# Council members (leave a key blank to skip that member; COUNCIL_MIN_MEMBERS must still answer)
GROQ_API_KEY=                    # momentum analyst
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=              # deep-reasoning analyst
OPENROUTER_MODEL=openrouter/free
MISTRAL_API_KEY=                 # algorithmic-logic analyst
MISTRAL_MODEL=mistral-small-latest
HUGGINGFACE_API_KEY=             # Qwen/DeepSeek via the HF Inference Router
HUGGINGFACE_MODEL=Qwen/Qwen2.5-72B-Instruct
# Supreme judge: synthesizes the council into the final strict-JSON decision
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_JUDGE_PROVIDER=gemini
AI_JUDGE_MIN_CONFIDENCE=75       # judge confidence required to authorize an entry
COUNCIL_MIN_MEMBERS=2            # quorum; below it the cycle fails closed to HOLD
AI_DEADLINE_SECONDS=45           # one deadline for the whole council + judge
AI_PROVIDER_COOLDOWN_SECONDS=60  # circuit-breaker cooldown after 429 / 5xx
AI_ENTRY_BLOCK_ON_UNAVAILABLE=true
AI_FALLBACK_TO_TECHNICAL=false   # true = use the technical signal when the council is down
AI_DAILY_CALL_LIMIT=0
AI_MINUTE_CALL_LIMIT=0
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Strategy mode and hybrid trigger ----
STRATEGY_MODE=ai_council         # technical | ai_council
SIGNAL_ON_CLOSED_CANDLES=true    # never trade on the forming candle (no look-ahead)
HYBRID_TRIGGER_ENABLED=true      # routine cycle on each 15m close + fast ticker polling
FAST_POLL_SECONDS=10
BREAKOUT_VOLUME_MULT=2.5         # forming-candle volume > 2.5x the 20-period average
BREAKOUT_LEVEL_BUFFER_BPS=5      # break of 24h high/low by this buffer
FAST_TRACK_COOLDOWN_SECONDS=300  # per-symbol cooldown between fast-track evaluations

# ---- Risk engine: ATR sizing, tiered exits, circuit breaker ----
RISK_MIN_PCT=1.0                 # equity risked per trade at low confidence
RISK_MAX_PCT=2.0                 # ...and at max confidence
MIN_STOP_BPS=30
RISK_INCLUDE_COSTS=true
TIERED_EXITS_ENABLED=true
TP1_R=1.5                        # TP1: close TP1_FRACTION, stop -> breakeven
TP1_FRACTION=0.5
TP2_R=3.0                        # TP2: close TP2_FRACTION; remainder is the ATR-trailed runner
TP2_FRACTION=0.25
TRAIL_ATR_MULT=2.0
CIRCUIT_BREAKER_DAILY_PCT=4.0    # daily drawdown that locks new entries
CIRCUIT_BREAKER_HOURS=24

# ---- Execution ----
EXEC_ORDER_STYLE=market          # market | limit_ioc
MAX_SLIPPAGE_BPS=30
EXEC_MAX_ATTEMPTS=3
LIVE_CONFIRMATION=               # optional typed confirmation phrase required at live start

# ---- Optional Telegram alerts + remote control ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_CHAT_IDS=

# ---- Optional TradingView webhook (needs DASHBOARD_PORT != 0 and a 16+ character secret) ----
TV_WEBHOOK_SECRET=

PAPER_VALIDATION_DAYS=30

# AI safety
AI_ENTRY_BLOCK_ON_UNAVAILABLE=true
AI_PROVIDER_COOLDOWN_SECONDS=60
AI_DAILY_CALL_LIMIT=0
AI_MINUTE_CALL_LIMIT=0
